# 依赖与构建
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/

# 环境与敏感信息（数据库凭据、会话密钥等）
.env
.env.*
!.env.example

# 数据库相关
*.sql
*.dump

# 日志与临时文件
logs/
*.log
.tmp/
docs/.edge-tmp*/
docs/_tmp-*
.dsh-vision-router/
scripts/_tmp-*
.npm-cache/

# 截图与验证产物
screenshots/
# 异常场景扫码测试产物（九张码 + 总览页 + manifest.json，由 scripts/seed-abnormal-demo.mjs 一键再生，不入库）
qr-test/

# 数据库备份文件（含全量数据，隐私）
backup/

# DSH 工具产物
.dsh/

# 系统文件
.DS_Store
Thumbs.db
# 临时截图产物（DSH 会话验证用）
.tmp-shot/

# 农药登记数据源文件（6.9MB xlsx，公开数据但体积大不入库；导入 scripts/import-regdata.mjs → pesticide_reg 表）
2026农药登记证大全*.xlsx

# 离线二维码生成工具发布件（便携版 EXE 约 90MB，体积过大不入库；
# 放 public/tools/ 由本机磁盘直接提供下载，部署时需单独拷贝该目录到服务器）
public/tools/*.exe
public/tools/*.zip
# 便携版离线工具运行时会自动在 **exe 同目录** 建 app-data/（Chromium userData：Cache / GPUCache /
# Local Storage / Local State / data.json…，约 5MB / 50 个文件）。
# ⚠️ 因此**别在 public/tools/ 里直接双击运行该 exe** —— 生成的缓存落在 public/ 下，会被 `nuxt build`
# 复制进网站公网目录（2026-09-19 实际发生过一次，已清理）。要试工具请去 app/dist/ 运行，或先把 exe 拷到别处。
public/tools/app-data/
# 本机诊断/临时输出（排查时把命令输出落盘成 _xxx.txt 再读；2026-09-19 起根目录也纳入）
# 起因：一天内两次被 `git add -A` 扫进仓库 —— 与其靠人记，不如让 git 直接看不见
/_*.txt
/_*.log
/_*.json

# Added by code-review-graph
.code-review-graph/
.playwright-cli/
# PPT 生成产物（slidep 流程，2026-09-28 起）
# ---------------------------------------------------------------
# 与产品无关的**一次性工作产物**，整体不入库（否则 `git status` 永远挂着一条未跟踪项）：
#   `.ppt-build-<日期>/build-deck.mjs` / `finalize.mjs`（文案与版式源码）与成品 `ppt-output/*.pptx`
#   **只留在本机磁盘**；已另备份到
#   `E:/software/workbuddy/文件存放处/2026-09-28-PPT九月工作总结-成品与源码/`。
# 2026-09-28 实测：该目录曾长到 425MB / 12,134 文件（大头是 py-runtime），已清理并进回收站。
.ppt-build-*/
/.ppt-build-*/
ppt-output/
.slidep/
