# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nz315

# 会话密钥（生产环境必须改为强随机值）
SESSION_SECRET=change-me-to-a-long-random-string

# 站点信息
SITE_URL=http://localhost:3000

# 扫码 URL 前缀（PRD 3.3）
# NUXT_PUBLIC_TRACE_BASE_URL=https://www.nz315.cn/trace?code=

# 微信公众号网页授权（消费者登录）
# 需已认证服务号，并在公众平台配置「网页授权域名」为 www.nz315.cn
# 未配置时公众端登录入口整体不可用（不会降级为模拟登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 高德 Web服务 key：**仅服务端**用于 IP 定位（server/utils/ip-geo.ts → 写 scan_log 的省/市，
# 关系「重复查询」预警链路）。不下发浏览器。
# 2026-09-23 公众端「附近门店」下线后，本 key 只剩这一个调用方（原先与 POI 周边搜索共用）。
AMAP_WEB_KEY=

