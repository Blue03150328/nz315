# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nz315

# 会话密钥（生产环境必须改为强随机值）
SESSION_SECRET=change-me-to-a-long-random-string

# 站点信息
SITE_URL=http://localhost:3000

# 扫码 URL 前缀（PRD 3.3）
# NUXT_PUBLIC_TRACE_BASE_URL=https://www.nz315.cn/trace?code=

# 微信公众号网页授权（消费者登录）
# 需已认证服务号，并在公众平台配置「网页授权域名」为 www.nz315.cn
# 未配置时公众端登录入口整体不可用（不会降级为模拟登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 高德地图 JS API（公众端「附近农资店」地图展示用）
# 申请类型选「Web端(JS API)」；2.0 起需同时配置安全密钥
# 未配置时页面自动降级为纯列表（定位与距离由浏览器定位 + 服务端计算，不依赖高德）
NUXT_PUBLIC_AMAP_JS_KEY=
NUXT_PUBLIC_AMAP_SECURITY_CODE=
